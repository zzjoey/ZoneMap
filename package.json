{
  "name": "zonemap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "concurrently \"vite --host\" \"tsx watch api/server.ts\"",
    "api": "tsx api/server.ts",
    "start": "tsx api/server.ts",
    "build": "tsc -b && vite build",
    "build:geonames": "node scripts/build-geonames.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup": "cp node_modules/world-atlas/countries-110m.json public/world-110m.json",
    "generate-cities": "node scripts/generate-cities.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "d3-geo": "^3.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "framer-motion": "^11.3.0",
    "hono": "^4.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.4",
    "@vitejs/plugin-react": "^4.3.1",
    "@vvo/tzdb": "^6.198.0",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
