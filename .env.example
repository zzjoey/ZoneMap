# API Security
# Comma-separated list of valid API keys for the city search API
API_KEYS=your-api-key-here

# Comma-separated allowed CORS origins (leave empty to allow all — dev only)
ALLOWED_ORIGINS=https://your-domain.com

# Rate limit: max requests per IP per minute (default: 60)
RATE_LIMIT_RPM=60

# Frontend: API key injected at build time (must match one value in API_KEYS)
VITE_API_KEY=your-api-key-here
